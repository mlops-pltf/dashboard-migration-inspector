guid: 271f2af6-c87f-5de0-bd18-90a6470f8582
table:
  name: FACT_ORDERS
  db: ANALYTICS
  schema: RETAIL
  db_table: FACT_ORDERS
  connection:
    name: Redshift Retail
    fqn: 83fc6beb-3f0f-5991-a2d0-62ef1d97b006
  columns:
  - name: Order ID
    db_column_name: ORDER_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: Order Timestamp
    db_column_name: ORDER_TS
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
    db_column_properties:
      data_type: DATE_TIME
  - name: Order Date
    db_column_name: ORDER_DATE
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
    db_column_properties:
      data_type: DATE
  - name: Customer ID
    db_column_name: CUSTOMER_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT32
  - name: Store ID
    db_column_name: STORE_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT32
  - name: Order Status
    db_column_name: ORDER_STATUS
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
    db_column_properties:
      data_type: VARCHAR
  - name: Order Amount
    db_column_name: ORDER_AMOUNT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: Discount Amount
    db_column_name: DISCOUNT_AMOUNT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: Shipping Amount
    db_column_name: SHIPPING_AMOUNT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: Item Count
    db_column_name: ITEM_COUNT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT32
  joins_with:
  - name: FACT_ORDERS_to_DIM_CUSTOMER
    destination:
      name: DIM_CUSTOMER
      fqn: 7d21d220-4407-5dfa-8456-b67e4ea0704a
    'on': '[FACT_ORDERS::Customer ID] = [DIM_CUSTOMER::Customer ID]'
    type: LEFT_OUTER
    is_one_to_one: false
  - name: FACT_ORDERS_to_DIM_STORE
    destination:
      name: DIM_STORE
      fqn: 2255bed9-70c7-5b65-976f-eb7de857a289
    'on': '[FACT_ORDERS::Store ID] = [DIM_STORE::Store ID]'
    type: LEFT_OUTER
    is_one_to_one: false
  - name: FACT_ORDERS_to_DIM_DATE
    destination:
      name: DIM_DATE
      fqn: cf951e85-d664-571b-8bee-9a000ed8bb90
    'on': '[FACT_ORDERS::Order Date] = [DIM_DATE::Date]'
    type: LEFT_OUTER
    is_one_to_one: false

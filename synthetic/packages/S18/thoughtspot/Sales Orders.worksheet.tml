guid: 23feb6f2-ac92-5b53-8fdf-10a5e07c354d
worksheet:
  name: Sales Orders
  description: Order-level sales analysis by customer, store and date.
  tables:
  - name: FACT_ORDERS
    fqn: 271f2af6-c87f-5de0-bd18-90a6470f8582
  - name: DIM_CUSTOMER
    fqn: 7d21d220-4407-5dfa-8456-b67e4ea0704a
  - name: DIM_STORE
    fqn: 2255bed9-70c7-5b65-976f-eb7de857a289
  - name: DIM_DATE
    fqn: cf951e85-d664-571b-8bee-9a000ed8bb90
  joins:
  - name: FACT_ORDERS_to_DIM_CUSTOMER
    source: FACT_ORDERS
    destination: DIM_CUSTOMER
    type: LEFT_OUTER
    is_one_to_one: false
  - name: FACT_ORDERS_to_DIM_STORE
    source: FACT_ORDERS
    destination: DIM_STORE
    type: LEFT_OUTER
    is_one_to_one: false
  - name: FACT_ORDERS_to_DIM_DATE
    source: FACT_ORDERS
    destination: DIM_DATE
    type: LEFT_OUTER
    is_one_to_one: false
  table_paths:
  - id: FACT_ORDERS_1
    table: FACT_ORDERS
    join_path:
    - {}
  - id: DIM_CUSTOMER_1
    table: DIM_CUSTOMER
    join_path:
    - join:
      - FACT_ORDERS_to_DIM_CUSTOMER
  - id: DIM_STORE_1
    table: DIM_STORE
    join_path:
    - join:
      - FACT_ORDERS_to_DIM_STORE
  - id: DIM_DATE_1
    table: DIM_DATE
    join_path:
    - join:
      - FACT_ORDERS_to_DIM_DATE
  formulas:
  - name: Order Count
    expr: unique count ( [FACT_ORDERS_1::Order ID] )
    id: formula_Order Count
  - name: Customer Count
    expr: unique count ( [FACT_ORDERS_1::Customer ID] )
    id: formula_Customer Count
  - name: Avg Order Value
    expr: sum ( [FACT_ORDERS_1::Order Amount] ) / unique count ( [FACT_ORDERS_1::Order ID] )
    id: formula_Avg Order Value
  - name: Discount Rate
    expr: safe_divide ( sum ( [FACT_ORDERS_1::Discount Amount] ) , sum ( [FACT_ORDERS_1::Order Amount] ) )
    id: formula_Discount Rate
  - name: Net Revenue
    expr: sum ( [FACT_ORDERS_1::Order Amount] - ifnull ( [FACT_ORDERS_1::Discount Amount] , 0 ) )
    id: formula_Net Revenue
  - name: Region Revenue
    expr: group_aggregate ( sum ( [FACT_ORDERS_1::Order Amount] ) , { [DIM_STORE_1::Region] } , query_filters ( ) )
    id: formula_Region Revenue
  filters:
  - column:
    - FACT_ORDERS_1::Order Status
    oper: not in
    values:
    - Cancelled
  worksheet_columns:
  - name: Order ID
    column_id: FACT_ORDERS_1::Order ID
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Order Date
    column_id: FACT_ORDERS_1::Order Date
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Order Status
    column_id: FACT_ORDERS_1::Order Status
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Customer ID
    column_id: FACT_ORDERS_1::Customer ID
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Store ID
    column_id: FACT_ORDERS_1::Store ID
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Customer Name
    column_id: DIM_CUSTOMER_1::Customer Name
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Customer Segment
    column_id: DIM_CUSTOMER_1::Segment
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
      synonyms:
      - Segment
  - name: Customer Region
    column_id: DIM_CUSTOMER_1::Region
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Store Name
    column_id: DIM_STORE_1::Store Name
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Store City
    column_id: DIM_STORE_1::City
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Store Region
    column_id: DIM_STORE_1::Region
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Store Type
    column_id: DIM_STORE_1::Store Type
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Order Week
    description: Week starting Monday
    column_id: DIM_DATE_1::Week Start Monday
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Order Month
    column_id: DIM_DATE_1::Month Start
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Order Quarter
    column_id: DIM_DATE_1::Quarter
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Order Year
    column_id: DIM_DATE_1::Year
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Fiscal Year
    description: Fiscal year starting in April
    column_id: DIM_DATE_1::Fiscal Year
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Revenue
    column_id: FACT_ORDERS_1::Order Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Sales
      - Order Amount
  - name: Discount
    column_id: FACT_ORDERS_1::Discount Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Shipping
    column_id: FACT_ORDERS_1::Shipping Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Items Sold
    column_id: FACT_ORDERS_1::Item Count
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Order Count
    formula_id: formula_Order Count
    properties:
      column_type: MEASURE
      index_type: DONT_INDEX
  - name: Customer Count
    formula_id: formula_Customer Count
    properties:
      column_type: MEASURE
      index_type: DONT_INDEX
  - name: Avg Order Value
    formula_id: formula_Avg Order Value
    properties:
      column_type: MEASURE
      index_type: DONT_INDEX
  - name: Discount Rate
    description: Discount as a share of revenue; 0 when revenue is 0
    formula_id: formula_Discount Rate
    properties:
      column_type: MEASURE
      index_type: DONT_INDEX
  - name: Net Revenue
    formula_id: formula_Net Revenue
    properties:
      column_type: MEASURE
      index_type: DONT_INDEX
  - name: Region Revenue
    description: Revenue of the whole store region, regardless of other grouping
    formula_id: formula_Region Revenue
    properties:
      column_type: MEASURE
      index_type: DONT_INDEX
  properties:
    is_bypass_rls: false
    join_progressive: true

guid: 60eb3a9e-6032-51d2-bfed-4be5de71ead6
table:
  name: FACT_ORDER_LINES
  db: ANALYTICS
  schema: RETAIL
  db_table: FACT_ORDER_LINES
  connection:
    name: Redshift Retail
    fqn: 83fc6beb-3f0f-5991-a2d0-62ef1d97b006
  columns:
  - name: Line ID
    db_column_name: LINE_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: Order ID
    db_column_name: ORDER_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: Line Number
    db_column_name: LINE_NUMBER
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
    db_column_properties:
      data_type: INT32
  - name: Product ID
    db_column_name: PRODUCT_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT32
  - name: Quantity
    db_column_name: QUANTITY
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT32
  - name: Unit Price
    db_column_name: UNIT_PRICE
    properties:
      column_type: MEASURE
      aggregation: AVERAGE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: Line Amount
    db_column_name: LINE_AMOUNT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  - name: Line Cost
    db_column_name: LINE_COST
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  joins_with:
  - name: FACT_ORDER_LINES_to_FACT_ORDERS
    destination:
      name: FACT_ORDERS
      fqn: 271f2af6-c87f-5de0-bd18-90a6470f8582
    'on': '[FACT_ORDER_LINES::Order ID] = [FACT_ORDERS::Order ID]'
    type: LEFT_OUTER
    is_one_to_one: false
  - name: FACT_ORDER_LINES_to_DIM_PRODUCT
    destination:
      name: DIM_PRODUCT
      fqn: 1ffd6410-ca2b-5d8a-bdc9-470e8611afee
    'on': '[FACT_ORDER_LINES::Product ID] = [DIM_PRODUCT::Product ID]'
    type: LEFT_OUTER
    is_one_to_one: false

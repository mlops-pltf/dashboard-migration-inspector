guid: 929f03da-e033-516e-9c71-e143c34f30a6
table:
  name: FACT_RETURNS
  db: ANALYTICS
  schema: RETAIL
  db_table: FACT_RETURNS
  connection:
    name: Redshift Retail
    fqn: 83fc6beb-3f0f-5991-a2d0-62ef1d97b006
  columns:
  - name: Return ID
    db_column_name: RETURN_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: Order ID
    db_column_name: ORDER_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: Product ID
    db_column_name: PRODUCT_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT32
  - name: Return Date
    db_column_name: RETURN_DATE
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
    db_column_properties:
      data_type: DATE
  - name: Return Quantity
    db_column_name: RETURN_QTY
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT32
  - name: Refund Amount
    db_column_name: REFUND_AMOUNT
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: DOUBLE
  joins_with:
  - name: FACT_RETURNS_to_DIM_PRODUCT
    destination:
      name: DIM_PRODUCT
      fqn: 1ffd6410-ca2b-5d8a-bdc9-470e8611afee
    'on': '[FACT_RETURNS::Product ID] = [DIM_PRODUCT::Product ID]'
    type: LEFT_OUTER
    is_one_to_one: false

guid: 820bdd8e-30cf-5b45-ae1f-6f6bdbb24793
model:
  name: Order Lines
  description: Line-level product performance.
  model_tables:
  - name: FACT_ORDER_LINES
    fqn: 60eb3a9e-6032-51d2-bfed-4be5de71ead6
    joins:
    - with: FACT_ORDERS
      'on': '[FACT_ORDER_LINES::Order ID] = [FACT_ORDERS::Order ID]'
      type: LEFT_OUTER
      cardinality: MANY_TO_ONE
    - with: DIM_PRODUCT
      'on': '[FACT_ORDER_LINES::Product ID] = [DIM_PRODUCT::Product ID]'
      type: LEFT_OUTER
      cardinality: MANY_TO_ONE
  - name: FACT_ORDERS
    fqn: 271f2af6-c87f-5de0-bd18-90a6470f8582
    joins:
    - with: DIM_DATE
      'on': '[FACT_ORDERS::Order Date] = [DIM_DATE::Date]'
      type: LEFT_OUTER
      cardinality: MANY_TO_ONE
  - name: DIM_PRODUCT
    fqn: 1ffd6410-ca2b-5d8a-bdc9-470e8611afee
  - name: DIM_DATE
    fqn: cf951e85-d664-571b-8bee-9a000ed8bb90
  formulas:
  - id: formula_Gross Margin
    name: Gross Margin
    expr: sum ( [FACT_ORDER_LINES::Line Amount] ) - sum ( [FACT_ORDER_LINES::Line Cost] )
  - id: formula_Margin %
    name: Margin %
    expr: ( sum ( [FACT_ORDER_LINES::Line Amount] ) - sum ( [FACT_ORDER_LINES::Line Cost] ) ) / sum ( [FACT_ORDER_LINES::Line
      Amount] )
  - id: formula_Avg Selling Price
    name: Avg Selling Price
    expr: sum ( [FACT_ORDER_LINES::Line Amount] ) / sum ( [FACT_ORDER_LINES::Quantity] )
  columns:
  - name: Order ID
    column_id: FACT_ORDERS::Order ID
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Order Date
    column_id: FACT_ORDERS::Order Date
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Order Status
    column_id: FACT_ORDERS::Order Status
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Product ID
    column_id: FACT_ORDER_LINES::Product ID
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Product Name
    column_id: DIM_PRODUCT::Product Name
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Category
    column_id: DIM_PRODUCT::Category
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Subcategory
    column_id: DIM_PRODUCT::Subcategory
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Brand
    column_id: DIM_PRODUCT::Brand
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Order Month
    column_id: DIM_DATE::Month Start
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Order Year
    column_id: DIM_DATE::Year
    properties:
      column_type: ATTRIBUTE
      index_type: DEFAULT
  - name: Units
    column_id: FACT_ORDER_LINES::Quantity
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Line Revenue
    column_id: FACT_ORDER_LINES::Line Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Line Cost
    column_id: FACT_ORDER_LINES::Line Cost
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Gross Margin
    formula_id: formula_Gross Margin
    properties:
      column_type: MEASURE
      index_type: DONT_INDEX
  - name: Margin %
    description: Margin as a share of line revenue (ratio of sums)
    formula_id: formula_Margin %
    properties:
      column_type: MEASURE
      index_type: DONT_INDEX
  - name: Avg Selling Price
    formula_id: formula_Avg Selling Price
    properties:
      column_type: MEASURE
      index_type: DONT_INDEX
  properties:
    is_bypass_rls: false
    join_progressive: true

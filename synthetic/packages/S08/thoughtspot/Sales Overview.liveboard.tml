guid: ee0a115b-6fa3-5234-94dd-7530584d5e9f
liveboard:
  name: Sales Overview
  visualizations:
  - id: Viz_1
    answer:
      name: Revenue by Store Region
      tables:
      - id: Sales Orders
        name: Sales Orders
        fqn: 23feb6f2-ac92-5b53-8fdf-10a5e07c354d
      search_query: '[Store Region] [Revenue] sort by [Revenue] descending'
      answer_columns:
      - name: Store Region
      - name: Total Revenue
      table:
        table_columns:
        - column_id: Store Region
          show_headline: false
        - column_id: Total Revenue
          show_headline: false
        ordered_column_ids:
        - Store Region
        - Total Revenue
      chart:
        type: COLUMN
        chart_columns:
        - column_id: Store Region
        - column_id: Total Revenue
        axis_configs:
        - x:
          - Store Region
          y:
          - Total Revenue
      display_mode: CHART_MODE
    viz_guid: fda5f4d7-786e-5f50-96bc-dd7f942cb9aa

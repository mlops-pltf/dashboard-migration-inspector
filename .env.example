# Copy to .env (never commit .env). docker compose reads .env itself; for processes started by hand use
# `uv run --env-file .env ...`. An empty value means "use the default".

# ===== Models (all agents) =====
# `uv run infra/runpod/llm_pod.py up` prints the four lines for the RunPod vLLM pod.
#   RunPod vLLM (OpenAI-compatible): model Qwen/Qwen3-32B-AWQ, INSPECTOR_LLM_API_BASE = the pod's .../v1 URL
#   Bedrock: leave INSPECTOR_LLM_API_BASE empty; model = a Bedrock model or inference profile id (AWS credentials)
INSPECTOR_LLM_MODEL_STRONG=
# Defaults to the strong model.
INSPECTOR_LLM_MODEL_FAST=
INSPECTOR_LLM_API_BASE=
INSPECTOR_LLM_API_KEY=
# Only for infra/runpod/llm_pod.py.
RUNPOD_API_KEY=

# ===== AWS: Bedrock models, S3 packages and reports, SigV4 between agents =====
# Locally also AWS_PROFILE or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY; on AgentCore the runtime role.
# AWS_ENDPOINT_URL points at an S3-compatible store instead of AWS S3.
AWS_REGION=

# ===== How the Inspector reaches the other agents =====
# A URL, or an AgentCore runtime ARN (arn:aws:bedrock-agentcore:<region>:<account>:runtime/<id>).
# Defaults http://localhost:9001/, :9002/, :9003/ (docker compose sets the service names itself).
INSPECTOR_THOUGHTSPOT_AGENT_URL=
INSPECTOR_STRATEGY_AGENT_URL=
INSPECTOR_DATA_AGENT_URL=
# none | sigv4 (sigv4 on AgentCore).
INSPECTOR_A2A_AUTH=none

# ===== Each agent's own server =====
# A2A_PORT: port to serve on. 9000 is the AgentCore contract; use 9000-9003 for four local processes.
# AGENTCORE_RUNTIME_URL: the URL this agent's card advertises (only matters for AWS Agent Registry).
# INSPECTOR_LOG_LEVEL: INFO progress lines | DEBUG | WARNING quiet.
INSPECTOR_LOG_LEVEL=INFO
# INSPECTOR_PLUGINS: comma-separated modules imported at start-up to register a host's own warehouse backend,
# package reader, run-folder writer or agent lookup (see inspector_contract/plugins.py).
INSPECTOR_PLUGINS=

# ===== Packages in, reports out =====
# A package location is a folder, a .zip, s3://bucket/prefix/ or s3://bucket/key.zip (register_reader for more).
# PACKAGE_ROOT: local packages must sit under these folders (':'-separated); empty = anywhere.
PACKAGE_ROOT=
# INSPECTOR_RUNS_DIR: run folders go to a folder, s3://bucket/prefix, or a registered scheme; empty = not saved.
INSPECTOR_RUNS_DIR=

# ===== Data agent: the warehouse =====
# WAREHOUSE_BACKEND: postgres (a direct connection) | a backend registered with register_backend().
WAREHOUSE_BACKEND=postgres
WAREHOUSE_DSN=postgresql://inspector_ro:inspector_ro@localhost:5439/analytics
# postgres | redshift: queries arrive in Redshift dialect and are transpiled to this one.
WAREHOUSE_DIALECT=postgres
WAREHOUSE_ALLOWED_SCHEMAS=retail
WAREHOUSE_TIMEOUT_S=60

# ===== Developer portal (docker compose --profile portal) =====
# PORTAL_API_URL (default http://localhost:8080); PORTAL_INSPECTOR_URL, PORTAL_THOUGHTSPOT_URL,
# PORTAL_STRATEGY_URL (URLs or runtime ARNs); PORTAL_A2A_AUTH; PORTAL_DATA_DIR; PORTAL_UPLOADS_DIR;
# PORTAL_AGENT_UPLOADS_PATH; PORTAL_MAX_PARALLEL_RUNS (2); PORTAL_MAX_TURNS (60).

# ===== Live evaluation (pytest; costs model calls) =====
# INSPECTOR_LIVE_EVAL=1 and optionally INSPECTOR_EVAL_SCENARIOS=S04,S14

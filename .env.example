# Copy to .env (never commit .env)

# Which LiteLLM profile to load: anthropic | ollama  (files in infra/litellm/)
LITELLM_PROFILE=anthropic
# Key agents use to call the LiteLLM proxy (any string locally)
LITELLM_MASTER_KEY=sk-inspector-local

# Anthropic profile
ANTHROPIC_API_KEY=

# Ollama profile: compose service by default; use http://host.docker.internal:11434 for native Ollama on the Mac
OLLAMA_API_BASE=http://ollama:11434

# Copy to .env (never commit .env)

# Models, as LiteLLM model ids. Agents call the provider directly.
#   Ollama:    ollama_chat/qwen3:14b            (INSPECTOR_LLM_API_BASE = the Ollama server)
#   RunPod:    hosted_vllm/Qwen/Qwen3-32B-AWQ   (`uv run infra/runpod/llm_pod.py up` prints all four lines)
#   Anthropic: anthropic/claude-sonnet-5-5      (needs ANTHROPIC_API_KEY)
#   Bedrock:   bedrock/<model or inference profile id>   (AWS credentials / AgentCore role)
INSPECTOR_LLM_MODEL_STRONG=ollama_chat/qwen3:14b
INSPECTOR_LLM_MODEL_FAST=ollama_chat/qwen3:8b

# Ollama on the Mac (from containers): http://host.docker.internal:11434
# Ollama container (--profile local-llm): http://ollama:11434
# A remote Ollama (e.g. RunPod): its URL
INSPECTOR_LLM_API_BASE=http://host.docker.internal:11434

# Key for INSPECTOR_LLM_API_BASE (the RunPod vLLM server)
INSPECTOR_LLM_API_KEY=

# Anthropic API key, only for anthropic/... models
ANTHROPIC_API_KEY=

# Tracing: OpenTelemetry exported to Langfuse (keys from the Langfuse project settings). Unset = no export.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com      # EU cloud; https://us.cloud.langfuse.com for US
# false keeps SQL, results and text out of the custom spans
INSPECTOR_TRACE_CONTENT=true
